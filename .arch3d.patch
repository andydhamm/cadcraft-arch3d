+#[test]
+fn model_without_phase17_values_writes_the_same_json() {
+    let mut m = ArchModel::default();
+    let w = m.push_wall(Wall::new(Vec2::new(0.0, 0.0), Vec2::new(5.0, 0.0), 0.2));
