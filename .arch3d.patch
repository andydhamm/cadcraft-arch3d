+    let mut r = crate::Railing::default();
+    r.id = crate::ArchId(5);
+    r.path = vec![cadcraft_geom::Vec2::new(0.0, 0.0), cadcraft_geom::Vec2::new(10.0, 0.0), cadcraft_geom::Vec2::new(10.0, 8.0)];
